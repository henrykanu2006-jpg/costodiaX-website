# Postgres connection string — auto-set when you connect a Neon/Postgres
# database to this project in Vercel's Storage tab. Copy the same value
# locally as DATABASE_URL if you want to run the tracker in dev.
DATABASE_URL=

# Password for the /admin shipment dashboard. Set this yourself in
# Vercel's Environment Variables — pick something strong, not this.
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=
